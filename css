/* ===== Tokens ===== */
:root {
  --navy: #07122b;
  --navy2: #0f2350;
  --accent: #2563eb;
  --accent2: #60a5fa;
  --ink: #0f172a;
  --muted: #5b6b82;
  --bg: #eaf0fa;
  --line: #dde6f3;
  --safe: #15803d;
  --safe-bg: #dcfce7;
  --warn: #b45309;
  --warn-bg: #fef3c7;
  --bad: #b91c1c;
  --bad-bg: #fee2e2;
  --unk: #475569;
  --unk-bg: #e2e8f0;
  --vc: var(--unk);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 16px/1.55 "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

.wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 18px;
}

.sr { position: absolute; left: -9999px; }

:focus-visible {
  outline: 3px solid #f59e0b;
  outline-offset: 2px;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 44px 0 84px;
  background:
    radial-gradient(900px 400px at 85% 0, rgba(59,130,246,.35), transparent 60%),
    linear-gradient(135deg, var(--navy), var(--navy2));
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
  background-size: 36px 36px;
  mask-image: linear-gradient(90deg, transparent, #000 70%);
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 70%);
}

.hero .wrap {
  position: relative;
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 28px;
  align-items: center;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  color: var(--accent2);
  margin-bottom: 10px;
}

.hero h1 {
  margin: 0 0 12px;
  font-size: clamp(2.2rem, 6vw, 3.6rem);
  line-height: 1.05;
  letter-spacing: -.03em;
}

.hero p {
  margin: 0 0 18px;
  color: #c7d6f0;
  font-size: 1.08rem;
  max-width: 46ch;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chips span {
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.18);
  padding: 5px 12px;
  border-radius: 999px;
  font-size: .85rem;
  color: #e2ecff;
}

.scanner {
  justify-self: center;
  position: relative;
  width: min(220px, 60vw);
  aspect-ratio: 1;
  background: #fff;
  border-radius: 22px;
  padding: 18px;
  box-shadow:
    0 0 0 8px rgba(96,165,250,.25),
    0 24px 60px rgba(0,0,0,.45);
}

.scanner svg {
  width: 100%;
  height: 100%;
  display: block;
}

.scanner i {
  position: absolute;
  left: 8px;
  right: 8px;
  top: 12px;
  height: 3px;
  border-radius: 3px;
  background: var(--accent);
  box-shadow: 0 0 18px 4px rgba(37,99,235,.7);
  animation: scan 2.6s ease-in-out infinite alternate;
}

@keyframes scan {
  to { top: calc(100% - 15px); }
}

@media (prefers-reduced-motion: reduce) {
  .scanner i { animation: none; top: 50%; }
  .loading { animation: none !important; }
}

@media (max-width: 760px) {
  .hero .wrap { grid-template-columns: 1fr; }
  .scanner { display: none; }
}

main {
  margin-top: -52px;
  padding-bottom: 36px;
  position: relative;
}

/* ===== Cards ===== */
.card {
  background: #fff;
  border-radius: 22px;
  padding: 26px;
  margin-bottom: 22px;
  box-shadow: 0 14px 40px rgba(7,18,43,.12);
}

.card > h2,
.hist-head h2 {
  margin: 0 0 4px;
  font-size: 1.4rem;
  letter-spacing: -.02em;
}

.sub {
  margin: 0 0 18px;
  color: var(--muted);
  font-size: .95rem;
}

.inputs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
}

.box {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: linear-gradient(#fbfdff, #fff);
}

.box h3 {
  margin: 0;
  font-size: 1.05rem;
  display: flex;
  align-items: center;
  gap: 10px;
}

.ico {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: #e0ebff;
  font-size: 1.05rem;
}

.hint {
  margin: 0;
  color: var(--muted);
  font-size: .9rem;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* Full-width built-in samples block */
.samples-box {
  margin-top: 16px;
  width: 100%;
  grid-column: 1 / -1;
}

.drop {
  position: relative;
  display: grid;
  place-items: center;
  text-align: center;
  gap: 2px;
  min-height: 130px;
  border: 2px dashed #9db8ee;
  border-radius: 14px;
  background: #f4f8ff;
  color: var(--accent);
  font-weight: 700;
  cursor: pointer;
  transition: .15s;
}

.drop:hover,
.drop:focus-within {
  background: #e8f0ff;
  border-color: var(--accent);
}

.drop small {
  color: var(--muted);
  font-weight: 500;
}

.drop input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
}

textarea {
  width: 100%;
  border: 1px solid #9fb0c8;
  border-radius: 12px;
  padding: 12px;
  font: .9rem ui-monospace, Consolas, monospace;
  resize: vertical;
  background: #fff;
}

textarea:focus {
  border-color: var(--accent);
}

/* ===== Buttons ===== */
.btn {
  border: 1.5px solid #a5b4cc;
  background: #fff;
  color: var(--ink);
  padding: 10px 16px;
  border-radius: 12px;
  font: 600 .95rem inherit;
  font-family: inherit;
  cursor: pointer;
  transition: .15s;
}

.btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 6px 14px rgba(7,18,43,.12);
}

.btn:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.btn.primary {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-color: transparent;
  color: #fff;
}

.s-safe {
  background: var(--safe-bg);
  border-color: #86d9a3;
  color: var(--safe);
}

.s-susp {
  background: var(--warn-bg);
  border-color: #f3cd78;
  color: var(--warn);
}

.s-danger {
  background: var(--bad-bg);
  border-color: #f2a3a3;
  color: var(--bad);
}

/* ===== Camera ===== */
.reader {
  min-height: 200px;
  border-radius: 16px;
  background: var(--navy);
  color: #8ea3c8;
  display: grid;
  place-items: center;
  overflow: hidden;
  text-align: center;
  font-size: .9rem;
  border: 3px solid #1e3a8a;
}

.reader video {
  border-radius: 12px;
}

.msg {
  margin: 0;
  font-size: .9rem;
  color: var(--muted);
}

.msg.error {
  color: var(--bad);
  font-weight: 700;
  margin-top: 14px;
}

/* ===== Result ===== */
.result {
  position: relative;
  overflow: hidden;
  border: 2px solid var(--line);
}

.result::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 8px;
  background: var(--vc);
}

.result[data-verdict=safe] {
  --vc: var(--safe);
  background: linear-gradient(#ecfdf3, #fff 220px);
  border-color: #a7e6bd;
}

.result[data-verdict=suspicious] {
  --vc: #d97706;
  background: linear-gradient(#fff8e6, #fff 220px);
  border-color: #f6d58a;
}

.result[data-verdict=dangerous] {
  --vc: var(--bad);
  background: linear-gradient(#fff0f0, #fff 220px);
  border-color: #f5b1b1;
}

.verdict-strip {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
  margin: 10px 0 6px;
}

.gauge {
  --p: 0%;
  width: 128px;
  height: 128px;
  border-radius: 50%;
  display: grid;
  place-content: center;
  text-align: center;
  flex: none;
  background:
    radial-gradient(closest-side, #fff 74%, transparent 76%),
    conic-gradient(var(--vc) var(--p), #e3eaf5 0);
}

.gauge b {
  font-size: 2.5rem;
  line-height: 1;
  color: var(--vc);
}

.gauge small {
  color: var(--muted);
  font-size: .78rem;
  font-weight: 600;
}

.vs-info {
  display: grid;
  gap: 6px;
}

.score {
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -.02em;
}

.badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 999px;
  font-weight: 800;
  font-size: .85rem;
  justify-self: start;
}

.badge.safe {
  background: var(--safe-bg);
  color: var(--safe);
}

.badge.suspicious {
  background: var(--warn-bg);
  color: var(--warn);
}

.badge.dangerous {
  background: var(--bad-bg);
  color: var(--bad);
}

.badge.unknown {
  background: var(--unk-bg);
  color: var(--unk);
}

.badge.big {
  font-size: 1.05rem;
  padding: 6px 18px;
}

.mono {
  font: .88rem/1.5 ui-monospace, Consolas, monospace;
  background: #0b1530;
  color: #d6e4ff;
  padding: 14px;
  border-radius: 12px;
  word-break: break-all;
  margin: 6px 0 16px;
  border-left: 4px solid var(--vc);
}

.details {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 6px 18px;
  margin: 8px 0 16px;
  font-size: .95rem;
  background: #f6f9fe;
  padding: 14px;
  border-radius: 12px;
}

.details dt {
  color: var(--muted);
  font-weight: 700;
}

.details dd {
  margin: 0;
  word-break: break-all;
}

h4 {
  margin: 18px 0 8px;
  font-size: 1rem;
}

.reasons {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}

.reasons li {
  border: 1px solid var(--line);
  border-left: 6px solid var(--vc);
  border-radius: 12px;
  padding: 12px 14px;
  background: #fff;
}

.reasons strong span {
  float: right;
  background: var(--bad-bg);
  color: var(--bad);
  padding: 1px 10px;
  border-radius: 999px;
  font-size: .85rem;
}

.reasons p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: .93rem;
}

.advice {
  margin-top: 18px;
  padding: 16px;
  border-radius: 14px;
  background: var(--unk-bg);
  font-weight: 600;
}

[data-verdict=safe] .advice { background: var(--safe-bg); }
[data-verdict=suspicious] .advice { background: var(--warn-bg); }
[data-verdict=dangerous] .advice { background: var(--bad-bg); }

.empty-state {
  text-align: center;
  padding: 26px 8px;
  color: var(--muted);
}

.empty-state .big {
  font-size: 2.6rem;
}

.loading {
  color: var(--muted);
  animation: pulse 1s infinite alternate;
  text-align: center;
  padding: 30px;
}

@keyframes pulse {
  to { opacity: .35; }
}

/* ===== History ===== */
.hist-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 14px;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: .9rem;
}

th,
td {
  text-align: left;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
}

tbody tr:last-child td {
  border-bottom: 0;
}

tbody tr:hover {
  background: #f6f9fe;
}

td:last-child {
  white-space: normal;
  font-family: ui-monospace, Consolas, monospace;
  word-break: break-all;
  min-width: 220px;
}

th {
  background: #eef3fb;
  color: var(--navy2);
}

.empty {
  color: var(--muted);
  text-align: center;
  padding: 20px 0 4px;
  margin: 0;
}

footer {
  background: var(--navy);
  color: #b7c8e6;
  padding: 24px 0;
  font-size: .9rem;
  text-align: center;
}

@media (max-width: 520px) {
  .details { grid-template-columns: 1fr; }
  .card { padding: 18px; }
  .gauge { width: 104px; height: 104px; }
}

/* ===== Button & result motion ===== */
@property --p {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 0%;
}

.btn {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.btn:active:not(:disabled) {
  transform: scale(.95);
  box-shadow: none;
}

.btn.primary::after {
  content: "";
  position: absolute;
  top: 0;
  left: -70%;
  width: 50%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent);
  transform: skewX(-20deg);
  transition: left .6s;
  z-index: -1;
}

.btn.primary:hover:not(:disabled)::after {
  left: 130%;
}

#cam-start:not(:disabled) {
  animation: glow 2.2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(37,99,235,.55); }
  50% { box-shadow: 0 0 0 10px rgba(37,99,235,0); }
}

.s-safe:hover:not(:disabled),
.s-susp:hover:not(:disabled),
.s-danger:hover:not(:disabled) {
  animation: wiggle .45s;
}

@keyframes wiggle {
  25% { transform: translateY(-3px) rotate(-1.5deg); }
  50% { transform: translateY(-3px) rotate(1.5deg); }
  75% { transform: translateY(-3px) rotate(-.8deg); }
}

.ico {
  transition: transform .25s;
}

.box:hover .ico {
  transform: scale(1.15) rotate(-8deg);
}

.drop:hover span {
  animation: bob .8s ease-in-out infinite alternate;
}

@keyframes bob {
  to { transform: translateY(-4px); }
}

.ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.55);
  transform: scale(0);
  animation: rip .6s ease-out forwards;
  pointer-events: none;
  z-index: -1;
}

.btn:not(.primary) .ripple {
  background: rgba(37,99,235,.25);
}

@keyframes rip {
  to {
    transform: scale(4);
    opacity: 0;
  }
}

.verdict-strip,
.reasons li,
.advice {
  animation: rise .5s ease-out both;
}

.reasons li:nth-child(2) { animation-delay: .08s; }
.reasons li:nth-child(3) { animation-delay: .16s; }
.reasons li:nth-child(n+4) { animation-delay: .24s; }

.gauge {
  animation: fill .9s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes fill {
  from { --p: 0%; }
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .btn,
  .btn *,
  #cam-start,
  .gauge,
  .verdict-strip,
  .reasons li,
  .advice,
  .drop span {
    animation: none !important;
    transition: none !important;
  }
}

/* ===== Colourful theme ===== */
[hidden] { display: none !important; }

body {
  background: linear-gradient(180deg, #e6efff, #f6e9ff 55%, #e3fbf4) fixed;
}

.hero {
  padding-top: 70px;
  background:
    radial-gradient(700px 360px at 92% 0, rgba(236,72,153,.5), transparent 60%),
    radial-gradient(600px 400px at 0 100%, rgba(34,211,238,.4), transparent 60%),
    linear-gradient(135deg, #0b1d4f, #3b1d8f 60%, #7c2a9c);
}

.brand { color: #7dd3fc; }

.card {
  position: relative;
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 6px;
  background: linear-gradient(90deg, #2563eb, #8b5cf6, #ec4899, #f59e0b);
}

.result::before {
  background: var(--vc);
}

.box {
  background: var(--t, #fff);
  border-top: 5px solid var(--c, #2563eb);
}

.box:nth-child(1) { --c: #2563eb; --t: #eef4ff; }
.box:nth-child(2) { --c: #06b6d4; --t: #ecfbff; }
.box:nth-child(3) { --c: #8b5cf6; --t: #f5f0ff; }

/* The full-width samples block */
.samples-box {
  --c: #f59e0b;
  --t: #fff7e8;
}

.ico {
  background: color-mix(in srgb, var(--c) 20%, transparent);
}

.btn.primary {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
}

.chips span:nth-child(1) { background: rgba(34,211,238,.25); }
.chips span:nth-child(2) { background: rgba(167,139,250,.3); }
.chips span:nth-child(3) { background: rgba(244,114,182,.28); }

.topbar {
  position: absolute;
  top: 16px;
  right: 18px;
  display: flex;
  gap: 8px;
  z-index: 3;
}

.btn.ghost {
  background: rgba(255,255,255,.15);
  color: #fff;
  border-color: rgba(255,255,255,.4);
  padding: 8px 14px;
}

.btn.ghost:hover:not(:disabled) {
  background: rgba(255,255,255,.28);
}

/* ===== Login ===== */
#login {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  padding: 18px;
  overflow: auto;
  background:
    radial-gradient(600px 400px at 85% 10%, rgba(34,211,238,.45), transparent 60%),
    radial-gradient(700px 500px at 10% 90%, rgba(244,114,182,.5), transparent 60%),
    linear-gradient(135deg, #0b1d4f, #4c1d95 55%, #be185d);
}

#login .topbar {
  position: fixed;
}

.login-card {
  width: min(410px, 100%);
  background: rgba(255,255,255,.96);
  color: #0f172a;
  border-radius: 26px;
  padding: 32px 28px;
  box-shadow: 0 30px 80px rgba(0,0,0,.45);
  animation: rise .6s ease-out both;
}

.login-card h2 {
  margin: 0 0 4px;
  font-size: 1.6rem;
  letter-spacing: -.02em;
}

.login-card .shield {
  font-size: 2.6rem;
  display: block;
  margin-bottom: 6px;
}

.login-card label {
  font-weight: 700;
  font-size: .9rem;
}

.login-card input {
  width: 100%;
  padding: 12px 14px;
  border: 1.5px solid #9fb0c8;
  border-radius: 12px;
  font: inherit;
  margin: 4px 0 14px;
  background: #fff;
  color: #0f172a;
}

.login-card input:focus {
  border-color: #7c3aed;
  outline: 3px solid rgba(124,58,237,.25);
}

.login-card .btn {
  width: 100%;
  padding: 13px;
}

.login-card .note {
  font-size: .82rem;
  color: #5b6b82;
  margin: 14px 0 0;
  text-align: center;
}

.login-card code {
  background: #eef2fb;
  padding: 1px 6px;
  border-radius: 6px;
}

/* ===== Dark mode ===== */
[data-theme=dark] {
  --ink: #e6edfb;
  --muted: #a3b3d3;
  --line: #2a3a64;
  --safe: #4ade80;
  --warn: #fbbf24;
  --bad: #f87171;
  --unk: #b3c0dc;
  --safe-bg: #0f3321;
  --warn-bg: #3a2a07;
  --bad-bg: #3d1214;
  --unk-bg: #1f2a44;
  color-scheme: dark;
}

[data-theme=dark] body {
  background: linear-gradient(180deg, #070d1f, #150b33 55%, #06161c) fixed;
}

[data-theme=dark] .card {
  background: #101a36;
}

[data-theme=dark] .box {
  background: color-mix(in srgb, var(--c) 14%, #101a36);
}

[data-theme=dark] .btn:not(.primary):not(.ghost):not(.s-safe):not(.s-susp):not(.s-danger):not(.tab) {
  background: #18264d;
  color: var(--ink);
  border-color: #3b4d7d;
}

[data-theme=dark] textarea,
[data-theme=dark] .login-card input {
  background: #0b1330;
  color: var(--ink);
  border-color: #3b4d7d;
}

[data-theme=dark] .drop {
  background: #0f1a3a;
  border-color: #4163b8;
  color: #8ab4ff;
}

[data-theme=dark] .drop:hover,
[data-theme=dark] .drop:focus-within {
  background: #16275a;
}

[data-theme=dark] .details,
[data-theme=dark] .reasons li {
  background: #0b1330;
}

[data-theme=dark] th {
  background: #16224a;
  color: #cfe0ff;
}

[data-theme=dark] tbody tr:hover {
  background: #16224a;
}

[data-theme=dark] .gauge {
  background:
    radial-gradient(closest-side, #101a36 74%, transparent 76%),
    conic-gradient(var(--vc) var(--p), #2a3a64 0);
}

[data-theme=dark] .result[data-verdict=safe] {
  background: linear-gradient(#0e2b1d, #101a36 220px);
  border-color: #1f6b40;
}

[data-theme=dark] .result[data-verdict=suspicious] {
  background: linear-gradient(#2e2208, #101a36 220px);
  border-color: #8a6310;
}

[data-theme=dark] .result[data-verdict=dangerous] {
  background: linear-gradient(#34131a, #101a36 220px);
  border-color: #8f2a2a;
}

[data-theme=dark] .login-card {
  background: rgba(16,26,54,.96);
  color: var(--ink);
}

[data-theme=dark] .login-card .note {
  color: var(--muted);
}

[data-theme=dark] .login-card code {
  background: #1b2a55;
}

/* ===== Live link check status ===== */
.live-status {
  font-size: .92rem;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 10px;
  background: var(--unk-bg);
  color: var(--unk);
}

.live-status.clear {
  background: var(--safe-bg);
  color: var(--safe);
}

.live-status.flagged {
  background: var(--bad-bg);
  color: var(--bad);
}

.live-status.checking {
  animation: pulse 1s infinite alternate;
}

.live-status.resolved {
  background: #dbeafe;
  color: #1d4ed8;
}

[data-theme=dark] .live-status.resolved {
  background: #16275a;
  color: #8ab4ff;
}

/* ===== Register / tabs ===== */
.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  background: #e8eefb;
  padding: 4px;
  border-radius: 14px;
  margin-bottom: 14px;
}

.tab {
  border: 0;
  background: transparent;
  padding: 10px;
  border-radius: 11px;
  font: 700 .95rem inherit;
  font-family: inherit;
  color: #475569;
  cursor: pointer;
  transition: .15s;
}

.tab[aria-selected=true] {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #fff;
  box-shadow: 0 4px 12px rgba(76,29,149,.35);
}

.msg.ok {
  color: var(--safe);
  font-weight: 700;
  min-height: 0;
  margin: 0 0 8px;
}

.msg.ok:empty { display: none; }

.show-pw {
  display: flex !important;
  align-items: center;
  gap: 8px;
  font-weight: 500 !important;
  color: #475569;
  margin: -6px 0 12px;
}

.show-pw input {
  width: auto !important;
  margin: 0 !important;
}

.meter {
  height: 6px;
  border-radius: 6px;
  background: #e3eaf5;
  overflow: hidden;
  margin: -6px 0 4px;
}

.meter i {
  display: block;
  height: 100%;
  width: 0;
  background: var(--bad);
  border-radius: 6px;
  transition: width .25s, background .25s;
}

.login-card small.hint {
  display: block;
  margin-bottom: 6px;
}

.who {
  align-self: center;
  color: #fff;
  font-weight: 600;
  font-size: .88rem;
  background: rgba(255,255,255,.15);
  padding: 6px 12px;
  border-radius: 999px;
}

@media (max-width: 560px) {
  .who { display: none; }
}

[data-theme=dark] .tabs {
  background: #0b1330;
}

[data-theme=dark] .tab {
  color: #a3b3d3;
}

[data-theme=dark] .tab[aria-selected=true] {
  color: #fff;
}

[data-theme=dark] .show-pw {
  color: var(--muted);
}

[data-theme=dark] .meter {
  background: #2a3a64;
}